@OptIn(
    ExperimentalAnimationApi::class
)
@Composable
private fun ModernBanner() {

    val banners =
        listOf(

            R.drawable.banner_s24_ultra,

            R.drawable.banner_s25_ultra,

            R.drawable.banner_oppo
        )

    var currentIndex by remember {
        mutableStateOf(0)
    }


    LaunchedEffect(Unit) {

        while (true) {

            delay(3000)

            currentIndex =
                (currentIndex + 1) %
                        banners.size
        }
    }


    val transition =
        rememberInfiniteTransition(
            label =
                "banner_zoom"
        )

    val scale by
    transition.animateFloat(

        initialValue =
            1.0f,

        targetValue =
            1.025f,

        animationSpec =
            infiniteRepeatable(

                animation =
                    tween(
                        durationMillis =
                            2200,

                        easing =
                            FastOutSlowInEasing
                    ),

                repeatMode =
                    RepeatMode.Reverse
            ),

        label =
            "banner_scale"
    )


    AnimatedContent(

        targetState =
            currentIndex,

        transitionSpec = {

            (
                    slideInHorizontally(
                        initialOffsetX = {
                            it
                        }
                    ) +
                            fadeIn(
                                animationSpec =
                                    tween(
                                        450
                                    )
                            )
                    ).togetherWith(

                    slideOutHorizontally(
                        targetOffsetX = {
                            -it
                        }
                    ) +
                            fadeOut(
                                animationSpec =
                                    tween(
                                        350
                                    )
                            )
                )
        },

        label =
            "banner_change"

    ) { index ->

        Box(

            modifier =
                Modifier
                    .fillMaxWidth()
                    .padding(
                        horizontal = 12.dp
                    )
                    .height(
                        180.dp
                    )
                    .clip(
                        RoundedCornerShape(
                            20.dp
                        )
                    )
                    .background(
                        CardColor
                    )
        ) {

            Image(

                painter =
                    painterResource(
                        id =
                            banners[index]
                    ),

                contentDescription =
                    "Banner Phone Store",

                modifier =
                    Modifier
                        .fillMaxSize()
                        .graphicsLayer {

                            scaleX =
                                scale

                            scaleY =
                                scale
                        },

                contentScale =
                    ContentScale.Crop
            )


            Row(

                modifier =
                    Modifier
                        .align(
                            Alignment.BottomCenter
                        )
                        .padding(
                            bottom = 9.dp
                        ),

                horizontalArrangement =
                    Arrangement.spacedBy(
                        6.dp
                    )
            ) {

                banners.forEachIndexed {
                        dotIndex,
                        _ ->

                    Box(

                        modifier =
                            Modifier
                                .size(

                                    if (
                                        dotIndex ==
                                        index
                                    ) {
                                        20.dp
                                    } else {
                                        7.dp
                                    }
                                )
                                .clip(
                                    RoundedCornerShape(
                                        50
                                    )
                                )
                                .background(

                                    if (
                                        dotIndex ==
                                        index
                                    ) {
                                        Color.White
                                    } else {
                                        Color.White.copy(
                                            alpha =
                                                0.55f
                                        )
                                    }
                                )
                    )
                }
            }
        }
    }
}


