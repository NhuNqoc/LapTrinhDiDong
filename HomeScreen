@Composable
private fun FloatingContactButtons(
    context: android.content.Context
) {

    val phoneNumber =
        "0968207886"

    Column(

        horizontalAlignment =
            Alignment.End,

        verticalArrangement =
            Arrangement.spacedBy(
                9.dp
            )
    ) {

        // ==================================================
        // HOTLINE
        // ==================================================

        Surface(

            modifier =
                Modifier.clickable {

                    try {

                        val intent =
                            Intent(
                                Intent.ACTION_DIAL,
                                Uri.parse(
                                    "tel:$phoneNumber"
                                )
                            )

                        context.startActivity(
                            intent
                        )

                    } catch (_: Exception) {
                    }
                },

            shape =
                RoundedCornerShape(
                    18.dp
                ),

            color =
                Color.White,

            shadowElevation =
                9.dp
        ) {

            Row(

                modifier =
                    Modifier.padding(
                        horizontal = 11.dp,
                        vertical = 8.dp
                    ),

                verticalAlignment =
                    Alignment.CenterVertically
            ) {

                Box(

                    modifier =
                        Modifier
                            .size(
                                36.dp
                            )
                            .clip(
                                RoundedCornerShape(
                                    50.dp
                                )
                            )
                            .background(
                                Color(0xFF16A34A)
                            ),

                    contentAlignment =
                        Alignment.Center
                ) {

                    Icon(

                        imageVector =
                            Icons.Default.Call,

                        contentDescription =
                            "Gọi điện",

                        tint =
                            Color.White,

                        modifier =
                            Modifier.size(
                                19.dp
                            )
                    )
                }

                Spacer(
                    modifier =
                        Modifier.width(
                            8.dp
                        )
                )

                Column {

                    Text(

                        text =
                            "HOTLINE",

                        color =
                            Color(0xFF64748B),

                        fontSize =
                            8.sp,

                        fontWeight =
                            FontWeight.Bold
                    )

                    Text(

                        text =
                            "0968 207 886",

                        color =
                            Color(0xFF111827),

                        fontSize =
                            11.sp,

                        fontWeight =
                            FontWeight.ExtraBold
                    )
                }
            }
        }


        // ==================================================
        // ZALO
        // ==================================================

        Surface(

            modifier =
                Modifier
                    .size(
                        58.dp
                    )
                    .clickable {

                        try {

                            val intent =
                                Intent(
                                    Intent.ACTION_VIEW,
                                    Uri.parse(
                                        "https://zalo.me/$phoneNumber"
