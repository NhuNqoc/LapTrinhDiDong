// ======================================================

private fun readHomeText(
    document: DocumentSnapshot,
    field: String
): String {

    return when (
        val value =
            document.get(field)
    ) {

        null ->
            ""

        is String ->
            value

        is Number ->
            value.toString()

        is Boolean ->
            value.toString()

        else ->
            value.toString()
    }
}


// ======================================================
// ẢNH MẶC ĐỊNH
// ======================================================

private fun fallbackImageForCategory(
    category: String
): Int {

    return when (
        category
            .trim()
            .lowercase()
    ) {

        "iphone" ->
            R.drawable.iphone15promax

        "samsung" ->
            R.drawable.samsung_s24_ultra

        "xiaomi" ->
            R.drawable.xiaomi14

        "oppo" ->
            R.drawable.oppo_reno12

        else ->
            R.drawable.iphone15promax
    }
}


